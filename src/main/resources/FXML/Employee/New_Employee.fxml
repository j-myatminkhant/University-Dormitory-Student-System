<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="940.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Employee.New_EmployeeController">
   <children>
      
      <!-- Dark navy rounded background container -->
      <AnchorPane layoutX="100.0" layoutY="150.0" prefHeight="400.0" prefWidth="740.0" style="-fx-background-color: #0c2951; -fx-background-radius: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" />
      
      <!-- Title -->
      <Label layoutX="220.0" layoutY="100.0" prefHeight="40.0" prefWidth="500.0" text="EMPLOYEE REGISTRATION FORM" textAlignment="CENTER" textFill="WHITE" style="-fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0, 1, 1);">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Left Column -->
      <Label layoutX="130.0" layoutY="180.0" prefHeight="20.0" prefWidth="180.0" text="EMPLOYEE NAME" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_emp_username" layoutX="130.0" layoutY="200.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Employee Name" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      
      <Label layoutX="130.0" layoutY="250.0" prefHeight="20.0" prefWidth="180.0" text="EMAIL" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_emp_email" layoutX="130.0" layoutY="270.0" prefHeight="35.0" prefWidth="250.0" promptText="eg.abc@gmail.com" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="130.0" layoutY="320.0" prefHeight="20.0" prefWidth="180.0" text="CONTACT NUMBER" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_emp_phnmb" layoutX="130.0" layoutY="340.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Contact No" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <!-- Right Column -->
      <Label layoutX="520.0" layoutY="180.0" prefHeight="20.0" prefWidth="180.0" text="NRC NO" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_emp_nic" layoutX="520.0" layoutY="200.0" prefHeight="35.0" prefWidth="250.0" promptText="eg.7/PMN(N)111111" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="520.0" layoutY="250.0" prefHeight="20.0" prefWidth="180.0" text="ADDRESS" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_emp_emgtel" layoutX="520.0" layoutY="270.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Address" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      
      <Label layoutX="520.0" layoutY="320.0" prefHeight="20.0" prefWidth="180.0" text="POSITION" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_emp_position" layoutX="520.0" layoutY="340.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Position" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <!-- Action Button -->
      <Button id="btn" fx:id="btn_reg_employee" layoutX="370.0" layoutY="460.0" mnemonicParsing="false" onMouseClicked="#registerButtonAction" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2e5995; -fx-text-fill: white; -fx-background-radius: 20px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 2);" text="REGISTER EMPLOYEE">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</AnchorPane>
