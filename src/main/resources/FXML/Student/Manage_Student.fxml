<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Student.Manage_StudentController">
   <children>
      <!-- Background Image -->
      <ImageView fitHeight="800.0" fitWidth="1280.0" pickOnBounds="true">
         <image>
            <Image url="@../../Images/2188.jpg" />
         </image>
      </ImageView>
      
      <!-- Gradient Overlay -->
      <Rectangle width="1280.0" height="800.0" fill="linear-gradient(to bottom right, rgba(37, 102, 229, 0.1), rgba(26, 48, 70, 0.2))" />
      
      <Pane prefHeight="800.0" prefWidth="1280.0">
         <children>
            <!-- Modern Left Sidebar -->
            <VBox layoutX="20.0" layoutY="40.0" prefHeight="720.0" prefWidth="300.0" styleClass="sidebar-container" stylesheets="@../../Styles/MenuSec.css">
               <children>
                  <!-- Sidebar Header -->
                  <VBox alignment="CENTER" spacing="10" styleClass="sidebar-container">
                     <padding>
                        <Insets top="30" right="20" bottom="20" left="20" />
                     </padding>
                     
                     <!-- Student Management Icon -->
                     <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../Images/b.png" />
                        </image>
                     </ImageView>
                     
                     <!-- Title -->
                     <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="STUDENT MANAGEMENT" textAlignment="CENTER" styleClass="sidebar-title">
                        <font>
                           <Font name="Segoe UI Black" size="16.0" />
                        </font>
                     </Text>
                     
                     <!-- Subtitle -->
                     <Text fill="rgba(255, 255, 255, 0.8)" strokeType="OUTSIDE" strokeWidth="0.0" text="Manage Student Records" textAlignment="CENTER">
                        <font>
                           <Font name="Segoe UI" size="12.0" />
                        </font>
                     </Text>
                     
                     <!-- Decorative Line -->
                     <Rectangle width="200.0" height="2.0" fill="rgba(255, 255, 255, 0.3)" style="-fx-effect: dropshadow(gaussian, rgba(255, 255, 255, 0.2), 2, 0, 0, 1);" />
                  </VBox>
                  
                  <!-- Quick Actions -->
                  <VBox alignment="CENTER" spacing="15" styleClass="sidebar-container">
                     <padding>
                        <Insets top="30" right="20" bottom="20" left="20" />
                     </padding>
                     
                     <!-- Add Student Button -->
                     <Button id="sidebar_btn" fx:id="btn_add_student" mnemonicParsing="false" onMouseClicked="#addStudentAction" prefHeight="55.0" prefWidth="260.0" text="➕ ADD STUDENT" textAlignment="CENTER" wrapText="true">
                        <font>
                           <Font name="Segoe UI Semibold" size="14.0" />
                        </font>
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </Button>
                     
                     <!-- Update Student Button -->
                     <Button id="sidebar_btn" fx:id="btn_update_student" mnemonicParsing="false" onMouseClicked="#updateStudentAction" prefHeight="55.0" prefWidth="260.0" text="✏️ UPDATE STUDENT" textAlignment="CENTER" wrapText="true">
                        <font>
                           <Font name="Segoe UI Semibold" size="14.0" />
                        </font>
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </Button>
                     
                     <!-- Delete Student Button -->
                     <Button id="sidebar_btn" fx:id="btn_delete_student" mnemonicParsing="false" onMouseClicked="#deleteStudentAction" prefHeight="55.0" prefWidth="260.0" text="🗑️ DELETE STUDENT" textAlignment="CENTER" wrapText="true">
                        <font>
                           <Font name="Segoe UI Semibold" size="14.0" />
                        </font>
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </Button>
                     
                     <!-- View Students Button -->
                     <Button id="sidebar_btn" fx:id="btn_view_student" mnemonicParsing="false" onMouseClicked="#viewStudentAction" prefHeight="55.0" prefWidth="260.0" text="👥 VIEW STUDENTS" textAlignment="CENTER" wrapText="true">
                        <font>
                           <Font name="Segoe UI Semibold" size="14.0" />
                        </font>
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </Button>
                  </VBox>
                  
                  <!-- Spacer -->
                  <VBox VBox.vgrow="ALWAYS" />
                  
                  <!-- Back Button -->
                  <VBox alignment="CENTER" styleClass="sidebar-container">
                     <padding>
                        <Insets top="20" right="20" bottom="30" left="20" />
                     </padding>
                     
                     <Button id="btn_back" fx:id="btn_back" mnemonicParsing="false" onMouseClicked="#back_btn_clicked" prefHeight="45.0" prefWidth="260.0" text="← BACK TO MAIN MENU" textAlignment="CENTER" wrapText="true">
                        <font>
                           <Font name="Segoe UI Semibold" size="14.0" />
                        </font>
                        <cursor>
                           <Cursor fx:constant="HAND" />
                        </cursor>
                     </Button>
                  </VBox>
               </children>
            </VBox>
            
            <!-- Dashboard Content Area -->
            <Pane fx:id="contentArea" layoutX="340.0" layoutY="40.0" prefHeight="720.0" prefWidth="920.0" styleClass="content-area" stylesheets="@../../Styles/MenuSec.css">
               <children>
                  <!-- Welcome Section -->
                  <VBox layoutX="0.0" layoutY="30.0" prefWidth="920.0" alignment="CENTER" spacing="15">
                     <children>
                        <!-- Main Title -->
                        <Text fill="#1a3046" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome to Dormitory Student Management" textAlignment="CENTER" styleClass="dashboard-title">
                           <font>
                              <Font name="Segoe UI Black" size="32.0" />
                           </font>
                        </Text>
                        
                        <!-- Subtitle -->
                        <Text fill="#2566E5" strokeType="OUTSIDE" strokeWidth="0.0" text="Comprehensive Student Record Management System" textAlignment="CENTER" styleClass="dashboard-subtitle">
                           <font>
                              <Font name="Segoe UI Semibold" size="18.0" />
                           </font>
                        </Text>
                        
                        <!-- Decorative Line -->
                        <Rectangle width="500.0" height="3.0" fill="#2566E5" style="-fx-effect: dropshadow(gaussian, rgba(37, 102, 229, 0.5), 3, 0, 0, 1);" />
                     </children>
                  </VBox>
                  
                  <!-- Total Students Statistics Box -->
                  <VBox layoutX="310.0" layoutY="250.0" spacing="15" alignment="CENTER" styleClass="stat-card">
                     <padding>
                        <Insets top="30" right="40" bottom="30" left="40" />
                     </padding>
                     <children>
                        <!-- Student Icon -->
                        <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../Images/S.png" />
                           </image>
                        </ImageView>
                        
                        <!-- Total Students Label -->
                        <Label fx:id="totalStudentsLabel" text="0" styleClass="stat-value" />
                        
                        <!-- Description -->
                        <Text fill="#666666" strokeType="OUTSIDE" strokeWidth="0.0" text="Total Students Living in Dorm" textAlignment="CENTER" styleClass="stat-label">
                           <font>
                              <Font name="Segoe UI Semibold" size="16.0" />
                           </font>
                        </Text>
                     </children>
                  </VBox>
                  
                  <!-- UIT Logo Image -->
                  <VBox layoutX="50.0" layoutY="350.0" alignment="CENTER" spacing="10">
                     <children>
                        <ImageView fitHeight="200.0" fitWidth="820.0" preserveRatio="true" pickOnBounds="true" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 10, 0, 0, 5);">
                           <image>
                              <Image url="@../../Images/UIT-Logo-Long-with-black-text (1).png" />
                           </image>
                        </ImageView>
                     </children>
                  </VBox>
               </children>
            </Pane>
         </children>
      </Pane>
   </children>
   <cursor>
      <Cursor fx:constant="DEFAULT" />
   </cursor>
</AnchorPane>
