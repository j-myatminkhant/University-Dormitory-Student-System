<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="940.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Student.New_StudentController">
   <children>
      
      <!-- Dark navy rounded background container -->
      <AnchorPane layoutX="100.0" layoutY="150.0" prefHeight="400.0" prefWidth="740.0" style="-fx-background-color: #0c2951; -fx-background-radius: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);" />
      
      <!-- Title -->
      <Label layoutX="220.0" layoutY="100.0" prefHeight="40.0" prefWidth="500.0" text="STUDENT REGISTRATION FORM" textAlignment="CENTER" textFill="WHITE" style="-fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0, 1, 1);">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Left Column -->
      <Label layoutX="130.0" layoutY="180.0" prefHeight="20.0" prefWidth="180.0" text="STUDENT NAME" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_username" layoutX="130.0" layoutY="200.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Student Name" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="130.0" layoutY="250.0" prefHeight="20.0" prefWidth="180.0" text="THANATA NO" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_nsbmid" layoutX="130.0" layoutY="270.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Thanata No" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="130.0" layoutY="320.0" prefHeight="20.0" prefWidth="180.0" text="EMAIL" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_email" layoutX="130.0" layoutY="340.0" prefHeight="35.0" prefWidth="250.0" promptText="abc@gmail.com" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="130.0" layoutY="390.0" prefHeight="20.0" prefWidth="180.0" text="CONTACT NUMBER" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_phnmb" layoutX="130.0" layoutY="410.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Contact No" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <!-- Right Column -->
      <Label layoutX="520.0" layoutY="180.0" prefHeight="20.0" prefWidth="180.0" text="NRC NO" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_nic" layoutX="520.0" layoutY="200.0" prefHeight="35.0" prefWidth="250.0" promptText="eg.7/PMN(N)111111" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="520.0" layoutY="250.0" prefHeight="20.0" prefWidth="180.0" text="ADDRESS" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_address" layoutX="520.0" layoutY="270.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Address" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="520.0" layoutY="320.0" prefHeight="20.0" prefWidth="180.0" text="GUARDIAN NAME" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_guardname" layoutX="520.0" layoutY="340.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Guardian Name" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <Label layoutX="520.0" layoutY="390.0" prefHeight="20.0" prefWidth="180.0" text="GUARDIAN TEL NO" textFill="WHITE">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="reg_txt_guardtel" layoutX="520.0" layoutY="410.0" prefHeight="35.0" prefWidth="250.0" promptText="Enter Guardian Tel No" style="-fx-background-radius: 12px; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 12px; -fx-border-width: 1.5px; -fx-padding: 10px;">
         <font>
            <Font name="Segoe UI" size="14.0" />
         </font>
      </TextField>
      
      <!-- Action Button -->
      <Button id="btn" fx:id="btn_reg_student" layoutX="370.0" layoutY="460.0" mnemonicParsing="false" onMouseClicked="#registerButtonAction" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2e5995; -fx-text-fill: white; -fx-background-radius: 20px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 2);" text="REGISTER STUDENT">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      
      <!-- Room Selection Section (Initially Hidden) -->
      <AnchorPane  fx:id="roomSelectionPane" layoutX="0.0" layoutY="0.0" prefHeight="700.0" prefWidth="940.0" style="-fx-background-color: transparent;" visible="false">
         <!-- Room Selection Title -->
         <Label layoutX="320.0" layoutY="20.0" prefHeight="40.0" prefWidth="300.0" text="SELECT ROOM" textAlignment="CENTER" textFill="#2C3E50">
            <font>
               <Font name="Segoe UI Bold" size="24.0" />
            </font>
         </Label>
         
         <!-- Room Grid Container -->
         <ScrollPane layoutX="50.0" layoutY="80.0" prefHeight="500.0" prefWidth="840.0" style="-fx-background-color: white; -fx-border-color:rgb(255, 255, 255); -fx-border-radius: 10px; -fx-background-radius: 10px;">
            <content>
               <GridPane fx:id="roomGrid" hgap="8.0" vgap="8.0" style="-fx-padding: 20px;">
                  <!-- Room buttons will be dynamically generated -->
               </GridPane>
            </content>
         </ScrollPane>
         
         <!-- Legend -->
         <Label layoutX="50.0" layoutY="590.0" text="Available Room" textFill="#28A745">
            <font>
               <Font name="Segoe UI Bold" size="12.0" />
            </font>
         </Label>
         <Button layoutX="20.0" layoutY="585.0" prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #28A745; -fx-background-radius: 5px;" />
         
         <Label layoutX="200.0" layoutY="590.0" text="Occupied Room" textFill="#DC3545">
            <font>
               <Font name="Segoe UI Bold" size="12.0" />
            </font>
         </Label>
         <Button layoutX="170.0" layoutY="585.0" prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #DC3545; -fx-background-radius: 5px;" />
         
         <Label layoutX="350.0" layoutY="590.0" text="Selected Room" textFill="#007BFF">
            <font>
               <Font name="Segoe UI Bold" size="12.0" />
            </font>
         </Label>
         <Button layoutX="320.0" layoutY="585.0" prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: #007BFF; -fx-background-radius: 5px;" />
         
         <!-- Action Buttons -->
         <Button fx:id="btn_choose_room" layoutX="650.0" layoutY="620.0" mnemonicParsing="false" onMouseClicked="#chooseRoomAction" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-background-radius: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 2);" text="CHOOSE">
            <font>
               <Font name="Segoe UI Bold" size="14.0" />
            </font>
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </Button>
         
         <Button fx:id="btn_back_to_form" layoutX="790.0" layoutY="620.0" mnemonicParsing="false" onMouseClicked="#backToFormAction" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-background-radius: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 6, 0, 0, 2);" text="BACK">
            <font>
               <Font name="Segoe UI Bold" size="14.0" />
            </font>
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </Button>
      </AnchorPane>
   </children>
</AnchorPane>
