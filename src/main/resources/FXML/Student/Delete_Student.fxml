<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="940.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Student.Delete_StudentController" stylesheets="@../Styles/MenuSec.css">
   <children>
      <!-- Title -->
      <Label layoutX="320.0" layoutY="20.0" prefHeight="40.0" prefWidth="540.0" text="DELETE STUDENT RECORDS" textAlignment="CENTER" textFill="#2C3E50">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- History Button at top right -->
      <Button fx:id="btn_history" layoutX="780.0" layoutY="20.0" mnemonicParsing="false" onMouseClicked="#showHistoryAction" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #1A2B40; -fx-text-fill: white; -fx-background-radius: 20px; -fx-font-weight: bold;" text="HISTORY">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      
      <!-- Search Box -->
      <Label layoutX="60.0" layoutY="80.0" prefHeight="25.0" prefWidth="200.0" text="SEARCH BY ID" textFill="#34495E">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txt_search_id" layoutX="60.0" layoutY="105.0" onKeyReleased="#searchStudentAction" prefHeight="45.0" prefWidth="250.0" promptText="Type Student ID to search..." style="-fx-background-radius: 15px; -fx-background-color: white; -fx-border-color: #3498DB; -fx-border-radius: 15px; -fx-border-width: 2px; -fx-font-size: 16px;">
         <font>
            <Font name="Segoe UI" size="16.0" />
         </font>
      </TextField>
      
      <!-- Student Information Display Area -->
      <Label layoutX="60.0" layoutY="170.0" prefHeight="25.0" prefWidth="250.0" text="STUDENT INFORMATION" textFill="#34495E">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
      
      <!-- ScrollPane for Student Table -->
      <ScrollPane fx:id="studentTableScrollPane" layoutX="60.0" layoutY="200.0" prefHeight="400.0" prefWidth="820.0" style="-fx-background-radius: 10px;" fitToWidth="false" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
         <content>
            <!-- Table for Search Results -->
            <TableView fx:id="tableStudent" editable="false" onMouseClicked="#displaySelectedAction" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="col_id" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="col_name" prefWidth="120.0" text="NAME" />
                  <TableColumn fx:id="col_nsbmid" prefWidth="110.0" text="THANATA NO" />
                  <TableColumn fx:id="col_email" prefWidth="140.0" text="EMAIL" />
                  <TableColumn fx:id="col_phonenumber" prefWidth="120.0" text="PHONE" />
                  <TableColumn fx:id="col_nic" prefWidth="150.0" text="NRC" />
                  <TableColumn fx:id="col_address" prefWidth="130.0" text="ADDRESS" />
                  <TableColumn fx:id="col_g_name" prefWidth="100.0" text="G_NAME" />
                  <TableColumn fx:id="col_g_tel" prefWidth="100.0" text="G_TEL" />
                  <TableColumn fx:id="col_room" prefWidth="80.0" text="ROOM" />
               </columns>
            </TableView>
         </content>
      </ScrollPane>
      
      <!-- Delete Button -->
      <Button id="btn" fx:id="btn_delete_student" layoutX="380.0" layoutY="620.0" mnemonicParsing="false" onMouseClicked="#deleteStudentButtonAction" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #0c2951; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="DELETE STUDENT">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      
      <!-- Search Box for Deleted Students (Initially Hidden) -->
      <Label fx:id="lbl_search_deleted" layoutX="60.0" layoutY="80.0" prefHeight="25.0" prefWidth="250.0" text="" textFill="#34495E" visible="false">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txt_search_deleted_id" layoutX="60.0" layoutY="105.0" onKeyReleased="#searchDeletedStudentAction" prefHeight="45.0" prefWidth="250.0" promptText="Type Student ID to search..." style="-fx-background-radius: 15px; -fx-background-color: white; -fx-border-color: #E74C3C; -fx-border-radius: 15px; -fx-border-width: 2px; -fx-font-size: 16px;" visible="false">
         <font>
            <Font name="Segoe UI" size="16.0" />
         </font>
      </TextField>
      
      <!-- ScrollPane for Deleted Students Table (Initially Hidden) -->
      <ScrollPane fx:id="deletedStudentTableScrollPane" layoutX="60.0" layoutY="200.0" prefHeight="400.0" prefWidth="820.0" style="-fx-background-radius: 10px;" fitToWidth="false" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" visible="false">
         <content>
            <!-- History Table -->
            <TableView fx:id="tableDeletedStudents" editable="false" style="-fx-background-radius: 10px;">
               <columns>
                  <TableColumn fx:id="col_deleted_id" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="col_deleted_name" prefWidth="120.0" text="NAME" />
                  <TableColumn fx:id="col_deleted_nsbmid" prefWidth="110.0" text="THANATA NO" />
                  <TableColumn fx:id="col_deleted_email" prefWidth="140.0" text="EMAIL" />
                  <TableColumn fx:id="col_deleted_phone" prefWidth="120.0" text="PHONE" />
                  <TableColumn fx:id="col_deleted_nic" prefWidth="150.0" text="NRC" />
                  <TableColumn fx:id="col_deleted_date" prefWidth="120.0" text="DELETED DATE" />
                  <TableColumn fx:id="col_deleted_address" prefWidth="200.0" text="ADDRESS" />
                  <TableColumn fx:id="col_deleted_room" prefWidth="80.0" text="ROOM" />
               </columns>
            </TableView>
         </content>
      </ScrollPane>
      
      <!-- Undo Button (Initially Hidden) -->
      <Button id="btn" fx:id="btn_undo_delete" layoutX="280.0" layoutY="620.0" mnemonicParsing="false" onMouseClicked="#undoDeleteAction" prefHeight="50.0" prefWidth="140.0" style="-fx-background-color: #1A2B40; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="UNDO DELETE" visible="false">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      
      <!-- Back to Main Button (Initially Hidden) -->
      <Button id="btn" fx:id="btn_back_to_main" layoutX="440.0" layoutY="620.0" mnemonicParsing="false" onMouseClicked="#backToMainAction" prefHeight="50.0" prefWidth="140.0" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-background-radius: 25px; -fx-font-weight: bold;" text="BACK" visible="false">
         <font>
            <Font name="Segoe UI Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</AnchorPane>
